# 服务器用 .env 模板（install.sh / bootstrap-local.sh 会替换三个随机值）
AUTH_SECRET=
HARNESS_ID_HMAC_KEY=
HARNESS_ADMIN_TOKENS=

# ===== 必填 =====
DEEPSEEK_API_KEY=

# ===== 寺庙向导外部服务 =====
AMAP_KEY=
QWEATHER_KEY=
QWEATHER_HOST=
TRAVEL_ENABLED=1
TRAVEL_DAILY_CAP=300
BOCHA_API_KEY=
BOCHA_ENABLED=1
BOCHA_DAILY_CAP=200

# ===== 成本与限流 =====
AGENT_COST_CAP_FREE_DAILY=2
AGENT_COST_CAP_FREE_MONTHLY=30
CHAT_RATE_PER_MIN=30
PROACTIVE_TZ=Asia/Shanghai
DATA_DIR=/app/data
